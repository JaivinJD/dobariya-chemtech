---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Each page passes its own title + description. Sensible defaults if it doesn't.
const {
  title = 'Dobariya Chemtech Pvt. Ltd. — Bromine Derivatives Manufacturer',
  description = 'Manufacturer and supplier of bromine derivatives in Ahmedabad, Gujarat. Alkyl, aryl and inorganic bromides at export-grade quality.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    	<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<Navbar />
		<slot />
		<Footer />
	</body>
</html>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // 1. Groups: children of a [data-reveal-group] cascade one after another.
  document.querySelectorAll('[data-reveal-group]').forEach((group) => {
    gsap.fromTo(
      group.children,
      { autoAlpha: 0, y: 40 },
      {
        autoAlpha: 1, y: 0,
        duration: 0.8, ease: 'power2.out',
        stagger: 0.12,                          // ← each child 0.12s after the last
        scrollTrigger: { trigger: group, start: 'top 80%' },
      }
    );
  });

  // 2. Singles: individual [data-reveal] elements, smooth scrub.
  document.querySelectorAll('[data-reveal]').forEach((el) => {
    gsap.fromTo(
      el,
      { autoAlpha: 0, y: 40 },
      {
        autoAlpha: 1, y: 0, duration: 1, ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 85%', end: 'top 55%', scrub: 1},
      }
    );
  });

  window.addEventListener('load', () => ScrollTrigger.refresh());
  
</script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
