---
// Light, framed call-to-action used at the end of inner pages.
//   <CtaStrip title="..." text="...">
//     <a class="btn btn--primary" ...>...</a>   buttons go in the default slot
//   </CtaStrip>
const { title, text } = Astro.props;
---

<div class="cta">
  <div>
    <p class="cta__title">{title}</p>
    {text && <p class="cta__text">{text}</p>}
  </div>
  <div class="cta__btns"><slot /></div>
</div>

<style>
  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px 40px;
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand);
  }
  .cta__title {
    font-family: var(--font-display);
    font-variation-settings: "wdth" var(--display-wdth);
    font-weight: var(--display-weight);
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__text { margin-top: 8px; max-width: 52ch; color: var(--color-muted); }
  .cta__btns { display: flex; flex-wrap: wrap; gap: 12px; }

  @media (max-width: 600px) {
    .cta__btns, .cta__btns :global(.btn) { width: 100%; justify-content: center; }
  }
</style>
