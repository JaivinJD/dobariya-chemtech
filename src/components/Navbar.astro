---
import LogoLockup from '../assets/logo-lockup.svg';

// overlay = true: transparent over a full-bleed hero, turns solid on scroll (homepage).
// overlay = false: solid dark bar from the start (every other page).
// "Solid" is always the dark ink band, so the top of every page reads the same.
const { overlay = false } = Astro.props;

// The nav links live as DATA. Add, remove or reorder a link here.
const links = [
  { label: 'About',    href: '/about' },
  { label: 'Products', href: '/products' },
  { label: 'Quality',  href: '/quality' },
  { label: 'Contact',  href: '/contact' },
];

// Highlight the current section ("/products/allyl-bromide" counts as Products).
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class:list={['nav', { 'nav--overlay': overlay, 'is-solid': !overlay }]} data-nav>
  <div class="container container--wide nav__in">
    <a href="/" class="nav__logo" aria-label="Dobariya Chemtech, home">
      <LogoLockup aria-hidden="true" />
    </a>

    <nav class="nav__links" id="nav-links" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} class="nav__link" aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href="/contact#enquiry" class="btn btn--primary nav__cta">Request a quote</a>
    </nav>

    <button class="nav__burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path class="l1" d="M3 7h18" /><path class="l2" d="M3 12h18" /><path class="l3" d="M3 17h18" />
      </svg>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    color: #fff;
    transition: background 0.3s, color 0.3s, box-shadow 0.3s;
  }
  /* Overlay mode: pinned on top of the hero, white text, no background */
  .nav--overlay { position: fixed; inset: 0 0 auto 0; color: #fff; }

  .nav.is-solid { background: var(--color-ink); color: #fff; box-shadow: 0 1px 0 var(--color-border-dark); }

  .nav__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 88px;
    transition: height 0.3s;
  }
  .nav.is-solid .nav__in { height: var(--nav-h); }

  /* The wordmark uses currentColor, so it follows the nav's text colour.
     The teal mark keeps its own fill. */
  .nav__logo { display: flex; color: inherit; }
  .nav__logo :global(svg) { height: 42px; width: auto; display: block; }

  .nav__links { display: flex; align-items: center; gap: 36px; }
  .nav__link {
    position: relative;
    padding-block: 6px;
    font-family: var(--font-display);
    font-variation-settings: "wdth" 110;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* underline that draws in on hover, and stays on the current page */
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0; right: 100%; bottom: 0;
    height: 1px;
    background: currentColor;
    transition: right 0.25s;
  }
  .nav__link:hover::after,
  .nav__link[aria-current="page"]::after { right: 0; }

  .nav__cta { height: 44px; }
  .nav__cta:hover { background: #fff; color: var(--color-ink); }

  .nav__burger { display: none; }

  @media (max-width: 900px) {
    .nav__burger {
      display: block;
      background: none;
      border: 0;
      color: inherit;
      padding: 8px;
      margin-right: -8px;
      cursor: pointer;
    }
    .nav__burger svg { width: 26px; height: 26px; display: block; }
    .nav__burger path { transition: transform 0.25s, opacity 0.2s; transform-origin: center; }
    .nav.is-open .l1 { transform: translateY(5px) rotate(45deg); }
    .nav.is-open .l2 { opacity: 0; }
    .nav.is-open .l3 { transform: translateY(-5px) rotate(-45deg); }

    .nav__in, .nav.is-solid .nav__in { height: 68px; }
    .nav__logo :global(svg) { height: 36px; }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 16px var(--gutter) 28px;
      background: var(--color-ink);
      color: #fff;
      border-bottom: 1px solid var(--color-border-dark);
    }
    .nav.is-open { background: var(--color-ink); color: #fff; }
    .nav.is-open .nav__links { display: flex; }
    .nav__link { font-size: 15px; padding-block: 12px; }
    .nav__cta { margin-top: 12px; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = nav?.querySelector<HTMLButtonElement>('.nav__burger');

  if (nav && burger) {
    // Overlay nav turns solid once the page scrolls a little.
    if (nav.classList.contains('nav--overlay')) {
      const update = () => nav.classList.toggle('is-solid', window.scrollY > 40);
      update();
      window.addEventListener('scroll', update, { passive: true });
    }

    burger.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }
</script>
