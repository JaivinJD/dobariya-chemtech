---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero.jpg';   // if yours is .png, change to hero.png

// Stats as data — every value real and verifiable, editable in one place.
const stats = [
  { value: '44+',  label: 'Bromine derivatives' },
  { value: '3',    label: 'Product categories' },
  { value: '2',    label: 'Facilities in Gujarat' },
  { value: '100%', label: 'In-house manufacturing' },
];
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <span class="hero__eyebrow">Manufacturer of Bromine Derivatives</span>
      <h1 class="hero__title">
        Bromine chemistry,<br />
        <span class="accent">engineered for purity.</span>
      </h1>
      <p class="hero__lead">
        In-house manufacturing in Kadi, Gujarat. Alkyl, aryl and inorganic
        bromides supplied at consistent, export-grade quality.
      </p>
      <div class="hero__actions">
        <a href="/products" class="btn btn--primary">Explore products →</a>
        <a href="/brochure.pdf" class="btn btn--ghost">Download brochure</a>
      </div>
    </div>

    <div class="hero__media">
      <Image src={heroImg} alt="Industrial storage silos at a chemical facility" class="hero__img" />
    </div>
  </div>

  <div class="container hero__stats">
    {stats.map((s) => (
      <div class="stat">
        <span class="stat__value">{s.value}</span>
        <span class="stat__label">{s.label}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero { background: var(--color-surface-2); padding-block: var(--space-lg); }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-lg);
    align-items: center;
  }
  .hero__eyebrow {
    display: inline-block;
    background: #fff;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4rem 0.7rem;
    border-radius: 4px;
    margin-bottom: var(--space-sm);
  }
  .hero__title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);   /* scales with screen width */
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }
  .hero__title .accent { color: var(--color-brand); }
  .hero__lead {
    margin-top: var(--space-sm);
    color: var(--color-muted);
    font-size: 1.05rem;
    max-width: 42ch;
  }
  .hero__actions { display: flex; gap: 0.8rem; margin-top: var(--space-md); flex-wrap: wrap; }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.95rem;
    transition: transform 0.15s ease, box-shadow 0.15s ease,
                background 0.15s ease, color 0.15s ease;
  }

  .hero__media {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-border);
  }
  .hero__img { width: 100%; height: 100%; object-fit: cover; }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }
  .stat__value {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-brand);
    line-height: 1;
  }
  .stat__label { font-size: 0.85rem; color: var(--color-muted); margin-top: 0.35rem; display: block; }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { order: -1; }               /* photo moves on top on mobile */
    .hero__stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>