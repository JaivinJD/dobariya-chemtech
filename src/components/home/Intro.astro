---
// Company intro + photo.
// (Addresses live in the footer and on Contact, so they are not repeated here.)
import PhotoSlot from '../ui/PhotoSlot.astro';
import ampouleImg from '../../assets/photos/ampoule.jpg';
import Arrow from '../ui/Arrow.astro';

---

<section class="intro">
  <div class="container intro__grid">
    <div class="intro__text" data-reveal>
      <span class="label">About the company</span>
      <div class="intro__copy">
        <p class="intro__lead">
          Dobariya Chemtech makes bromine derivatives at its own production facility in
          Kadi, with corporate offices in Ahmedabad.
        </p>
        <p>
          We are the chemical company of the{' '}
          <a href="https://dobariya.in" target="_blank" rel="noopener" class="intro__group">Dobariya Group</a>,{' '}
          which has been building across Ahmedabad since 1989. The same discipline runs our
          operations: in-house production, consistent specifications and a
          straightforward relationship with every buyer.
        </p>
      </div>
      <a href="/about" class="btn btn--ink intro__btn">About Dobariya Chemtech <Arrow /></a>
    </div>

    <div class="intro__media" data-reveal>
      <div class="intro__photo">
        <PhotoSlot src={ampouleImg} alt="Glass ampoule of red-brown liquid on a slate surface" />
      </div>
    </div>
  </div>
</section>

<style>
  .intro { padding-block: var(--section); }
  .intro__grid {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: clamp(40px, 6vw, 112px);
    align-items: center;
  }
  .intro__copy { margin-top: 24px; display: grid; gap: 18px; max-width: 52ch; color: var(--color-muted); }
  /* With no heading here, the lead sentence carries the section */
  .intro__lead { color: var(--color-ink); font-size: var(--fs-h3); line-height: 1.4; letter-spacing: -0.01em; }
  .intro__group {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-underline-offset: 3px;
  }
  .intro__group:hover { color: var(--color-brand-dark); }
  .intro__btn { margin-top: 36px; }

  .intro__media { display: grid; gap: 20px; }
  .intro__photo { aspect-ratio: 4 / 3; overflow: hidden; }

  @media (max-width: 900px) { .intro__grid { grid-template-columns: 1fr; } }
</style>
