---
import LogoLockup from '../assets/logo-lockup.svg';
import Wordmark from '../assets/logo-wordmark.svg';
// Contact details and addresses come from the CMS files, never hardcoded here.
import contact from '../data/contact.json';
import { offices } from '../data/offices.json';

const company = {
  legalName: 'Dobariya Chemtech Pvt. Ltd.',
  tagline: 'Manufacturer of bromine derivatives. Ahmedabad, Gujarat.',
};

const navLinks = [
  { label: 'Home',     href: '/' },
  { label: 'About',    href: '/about' },
  { label: 'Products', href: '/products' },
  { label: 'Quality',  href: '/quality' },
  { label: 'Contact',  href: '/contact' },
];

const tel = `tel:${contact.phone.replace(/\s/g, '')}`;
const year = new Date().getFullYear();
---

<footer class="foot on-dark">
  <div class="container">
    <div class="foot__top">
      <div class="foot__brand">
        <a href="/" class="foot__logo" aria-label="Dobariya Chemtech, home">
          <LogoLockup aria-hidden="true" />
        </a>
        <p class="foot__tag">{company.tagline}</p>
        <p class="foot__contact">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          <a href={tel}>{contact.phone}</a>
        </p>
      </div>

      {offices.map((office) => (
        <div>
          <h2 class="foot__h">{office.label}</h2>
          <p>{office.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
        </div>
      ))}

      <nav aria-label="Footer">
        <h2 class="foot__h">Explore</h2>
        <div class="foot__nav">
          {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
      </nav>
    </div>

    <Wordmark class="foot__word" aria-hidden="true" />
  </div>

  <div class="container foot__bar">
    <span>© {year} {company.legalName} All rights reserved.</span>
    <a class="foot__group" href="https://dobariya.in" target="_blank" rel="noopener">
      A Dobariya Group company · <u>dobariya.in</u> ↗
    </a>
  </div>
</footer>

<style>
  .foot {
    background: var(--color-ink);
    color: var(--color-muted-dark);
    padding-top: 88px;
    font-size: 15px;
  }
  .foot__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 0.7fr;
    gap: 48px;
    padding-bottom: 72px;
  }
  .foot__logo { display: inline-flex; color: #fff; }
  .foot__logo :global(svg) { height: 52px; width: auto; display: block; }
  .foot__tag { margin-top: 24px; max-width: 32ch; }
  .foot__contact { margin-top: 20px; display: grid; gap: 4px; }
  .foot__contact a { color: #fff; justify-self: start; }

  .foot .foot__h {
    margin-bottom: 18px;
    color: #fff;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-weight: 500;
    font-size: var(--fs-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .foot p { line-height: 1.75; }
  .foot__nav { display: grid; gap: 8px; justify-items: start; }
  .foot a { transition: color 0.2s; }
  .foot a:hover { color: #fff; }

  /* Oversized, barely-there wordmark. Decorative only. */
  /* Faint, oversized wordmark in the logo's own lettering. Decoration only. */
  .foot__word {
    display: block;
    width: min(100%, 980px);
    height: auto;
    color: #1F302F;
    user-select: none;
    pointer-events: none;
  }

  .foot__bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-block: 22px;
    font-size: 13px;
  }
  .foot__group { color: var(--color-on-dark); }
  .foot__group u { text-underline-offset: 3px; text-decoration-color: var(--color-brand); }

  @media (max-width: 1080px) { .foot__top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px)  { .foot__top { grid-template-columns: 1fr; gap: 36px; } }
</style>
