---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CtaStrip from '../components/ui/CtaStrip.astro';
import Arrow from '../components/ui/Arrow.astro';
import headerImg from '../assets/photos/ampoule.jpg';

const intro = {
  label: 'Quality',
  title: 'Consistency you can specify against',
  lead: 'Every batch is made to the same specification and checked before it ships. Here is how we keep our bromine derivatives dependable, lot after lot.',
};

// True today. No invented claims, certifications or purity figures.
const commitments = [
  { title: 'In-house manufacturing', text: 'We produce at our own facility in Kadi, giving us direct control over process and consistency.' },
  { title: 'Batch consistency', text: 'Each batch is made to the same specification, so what you order is what you receive, every time.' },
  { title: 'Export-grade standards', text: 'Our products are supplied to meet the quality expectations of domestic and international buyers.' },
  { title: 'Documentation on request', text: 'Technical and analysis documentation is available to support your purchasing and compliance needs.' },
];

// Standard industry documents buyers can request.
const documents = [
  { code: 'TDS', name: 'Technical Data Sheet', text: 'Product identity, specification and typical properties.' },
  { code: 'COA', name: 'Certificate of Analysis', text: 'Batch-specific test results for what you receive.' },
  { code: 'SDS', name: 'Safety Data Sheet', text: 'Handling, storage and safety information for safe use.' },
];
---

<Layout
  title="Quality | Dobariya Chemtech Pvt. Ltd."
  description="Consistent, export-grade bromine derivatives with batch consistency and documentation available on request."
>
  <PageHeader label={intro.label} title={intro.title} lead={intro.lead} image={headerImg} imagePos="75% 60%" />

  <!-- Commitments: 2 x 2, rule on top, no cards -->
  <section class="commit">
    <div class="container commit__grid">
      <h2 class="h2 commit__title">How we keep every batch the same.</h2>
      <div class="commit__list" data-reveal-group>
        {commitments.map((c) => (
          <div class="c">
            <h3 class="c__title">{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Documents: styled like document tabs -->
  <section class="docs sect-white">
    <div class="container">
      <span class="label">Documentation</span>
      <h2 class="h2 docs__title">Documents available on request.</h2>
      <div class="docs__grid" data-reveal-group>
        {documents.map((d) => (
          <div class="doc">
            <span class="doc__code">{d.code}</span>
            <h3 class="doc__name">{d.name}</h3>
            <p>{d.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications: an honest status note, nothing claimed -->
  <section class="certs">
    <div class="container certs__grid">
      <div>
        <span class="label">Certifications</span>
        <h2 class="certs__title">In progress.</h2>
      </div>
      <p class="certs__text">
        As our Kadi facility scales up, we are pursuing formal quality certifications.
        Current certification status and documentation are available on request.
      </p>
    </div>
  </section>

  <section class="end">
    <div class="container">
      <CtaStrip title="Need documentation for a specific product?" text="Request a quote and we'll include the technical details you need.">
        <a href="/contact#enquiry" class="btn btn--primary">Request a quote <Arrow /></a>
      </CtaStrip>
    </div>
  </section>
</Layout>

<style>
  /* ---- Commitments ---- */
  .commit { padding-block: var(--section); }
  .commit__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px clamp(40px, 6vw, 112px); }
  .commit__title { align-self: start; position: sticky; top: calc(var(--nav-h) + 40px); }
  .commit__list { display: grid; grid-template-columns: 1fr 1fr; gap: 48px 40px; }
  .c { padding-top: 20px; border-top: 1px solid var(--color-ink); }
  .c__title { font-size: var(--fs-h3); line-height: 1.15; margin-bottom: 10px; }
  .c p { color: var(--color-muted); }

  /* ---- Documents ---- */
  .docs { padding-block: var(--section); }
  .docs__title { margin-top: 18px; margin-bottom: 40px; }
  .docs__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .doc {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 28px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    /* folded corner, like a sheet of paper */
    clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 0 100%);
  }
  .doc::after {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    width: 28px;
    height: 28px;
    background: linear-gradient(225deg, var(--color-surface) 50%, var(--color-border) 50%);
  }
  .doc__code {
    font-family: var(--font-mono);
    font-size: 32px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-brand-dark);
  }
  .doc__name { margin-top: 48px; font-size: var(--fs-h3); line-height: 1.15; }
  .doc p { margin-top: 8px; color: var(--color-muted); }

  /* ---- Certifications ---- */
  .certs { padding-block: var(--section-sm); border-bottom: 1px solid var(--color-border); }
  .certs__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px clamp(40px, 6vw, 112px); align-items: end; }
  .certs__title { margin-top: 18px; font-variation-settings: "wdth" var(--display-wdth); font-size: var(--fs-h2); line-height: 1; letter-spacing: -0.03em; }
  .certs__text { max-width: 52ch; font-size: var(--fs-lead); line-height: 1.6; color: var(--color-muted); }

  .end { padding-block: var(--section-sm); }

  @media (max-width: 900px) {
    .commit__grid, .certs__grid { grid-template-columns: 1fr; }
    .commit__title { position: static; }
    .docs__grid { grid-template-columns: 1fr; }
    .doc { min-height: 0; }
  }
  @media (max-width: 600px) { .commit__list { grid-template-columns: 1fr; } }
</style>
