---
import Layout from '../layouts/Layout.astro';

const intro = {
  eyebrow: 'Quality',
  title: 'Consistency you can specify against',
  lead: 'Every batch is made to the same specification and checked before it ships. Here is how we keep our bromine derivatives dependable — lot after lot.',
};

// True today — no invented claims.
const commitments = [
  { title: 'In-house manufacturing', text: 'We produce at our own facility in Kadi, giving us direct control over process and consistency.' },
  { title: 'Batch consistency', text: 'Each batch is made to the same specification, so what you order is what you receive — every time.' },
  { title: 'Export-grade standards', text: 'Our products are supplied to meet the quality expectations of domestic and international buyers.' },
  { title: 'Documentation on request', text: 'Technical and analysis documentation is available to support your purchasing and compliance needs.' },
];

// The documents buyers can request (real, standard industry docs).
const documents = [
  { code: 'TDS', name: 'Technical Data Sheet', text: 'Product identity, specification and typical properties.' },
  { code: 'COA', name: 'Certificate of Analysis', text: 'Batch-specific test results for what you receive.' },
  { code: 'SDS', name: 'Safety Data Sheet', text: 'Handling, storage and safety information for safe use.' },
];
---

<Layout
  title="Quality — Dobariya Chemtech Pvt. Ltd."
  description="Consistent, export-grade bromine derivatives with batch consistency and documentation available on request."
>
  <section class="quality">
    <div class="container">
      <header class="quality__head">
        <span class="quality__eyebrow">{intro.eyebrow}</span>
        <h1 class="quality__title">{intro.title}</h1>
        <p class="quality__lead">{intro.lead}</p>
      </header>

      <div class="quality__grid">
        {commitments.map((c) => (
          <article class="qcard card">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </article>
        ))}
      </div>

      <div class="quality__docs">
        <h2 class="quality__subhead">Documentation we provide</h2>
        <div class="quality__docgrid">
          {documents.map((doc) => (
            <div class="doc">
              <span class="doc__code">{doc.code}</span>
              <div>
                <h4>{doc.name}</h4>
                <p>{doc.text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="quality__certs">
        <h2 class="quality__subhead">Certifications</h2>
        <p class="quality__certnote">
          As our Kadi facility scales up, we are pursuing formal quality certifications.
          Current certification status and documentation are available on request.
        </p>
      </div>

      <div class="quality__cta">
        <div>
          <h2>Need documentation for a specific product?</h2>
          <p>Request a quote and we'll include the technical details you need.</p>
        </div>
        <a href="/contact" class="btn btn--primary">Request a quote →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .quality { padding-block: var(--space-lg); }
  .quality__head { max-width: 720px; }
  .quality__eyebrow {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-brand); font-weight: 600;
  }
  .quality__title { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-ink); margin-top: 0.4rem; }
  .quality__lead { color: var(--color-muted); margin-top: var(--space-sm); font-size: 1.1rem; line-height: 1.6; }

  .quality__grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .qcard {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 12px; padding: var(--space-md);
  }
  .qcard h3 { font-size: 1.1rem; color: var(--color-ink); margin-bottom: 0.4rem; }
  .qcard p { font-size: 0.95rem; color: var(--color-muted); line-height: 1.65; }

  .quality__docs, .quality__certs { margin-top: var(--space-xl); }
  .quality__subhead { font-size: 1.5rem; color: var(--color-ink); margin-bottom: var(--space-md); }
  .quality__docgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); }
  .doc { display: flex; gap: var(--space-sm); align-items: flex-start; }
  .doc__code {
    flex-shrink: 0;
    font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;
    color: var(--color-brand);
    background: var(--color-brand-tint);
    padding: 0.4rem 0.6rem; border-radius: 8px;
  }
  .doc h4 { font-size: 1rem; color: var(--color-ink); }
  .doc p { font-size: 0.9rem; color: var(--color-muted); line-height: 1.55; margin-top: 0.2rem; }

  .quality__certnote {
    color: var(--color-muted); line-height: 1.7; max-width: 640px;
    background: var(--color-surface-2);
    border: 1px dashed var(--color-border);
    border-radius: 12px; padding: var(--space-md);
  }

  .quality__cta {
    margin-top: var(--space-xl);
    background: var(--color-ink);
    border-radius: 16px; padding: var(--space-lg);
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md); flex-wrap: wrap;
  }
  .quality__cta h2 { color: #fff; font-size: 1.4rem; }
  .quality__cta p { color: #b9c4c4; margin-top: 0.4rem; }

  @media (max-width: 860px) {
    .quality__grid { grid-template-columns: 1fr; }
    .quality__docgrid { grid-template-columns: 1fr; }
  }
</style>