---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Arrow from '../components/ui/Arrow.astro';
import { offices } from '../data/offices.json';
import contact from '../data/contact.json';
import panelImg from '../assets/photos/warehouse.jpg';

// Product names for the "Product" field suggestions.
const productNames = (await getCollection('products')).map((p) => p.data.name).sort();
const tel = `tel:${contact.phone.replace(/\s/g, '')}`;
---

<Layout
  title="Contact and Request a Quote | Dobariya Chemtech"
  description="Request a quote for bromine derivatives. Corporate office in Bodakdev, Ahmedabad and manufacturing in Kadi, Gujarat."
>
  <PageHeader
    label="Contact"
    title="Tell us what you need."
    lead="Send the product, grade and quantity. We respond with availability, pricing and documentation."
  />

  <!-- Layout follows dobariya.in/contact-us: photo panel on the left, form on the right -->
  <section class="enquiry" id="enquiry">
    <div class="container enquiry__grid">
      <aside class="panel on-dark">
        <Image src={panelImg} alt="" class="panel__img" widths={[640, 960, 1400]} sizes="(max-width: 900px) 100vw, 45vw" />
        <div class="panel__body">
          <h2 class="panel__title">Buying for export?</h2>
          <p class="panel__text">
            Technical data sheets, certificates of analysis and safety data sheets are
            available on request.
          </p>
          <a href={`https://wa.me/${contact.whatsapp}`} class="panel__link" target="_blank" rel="noopener">
            Chat on WhatsApp <Arrow />
          </a>
        </div>
      </aside>

      <!--
        NETLIFY FORMS WIRING: do not remove or rename any of these:
        name="contact", data-netlify, netlify-honeypot, the hidden form-name
        input, the bot-field input and its .hp-field wrapper.
      -->
      <form
        class="cform"
        name="contact"
        method="POST"
        action="/thanks"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp-field">
          <label>Don't fill this out: <input name="bot-field" /></label>
        </p>

        <div class="cform__grid">
          <div class="field">
            <label for="f-name">Full name <span aria-hidden="true">*</span></label>
            <input id="f-name" type="text" name="name" autocomplete="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label for="f-company">Company</label>
            <input id="f-company" type="text" name="company" autocomplete="organization" placeholder="Company name" />
          </div>
          <div class="field">
            <label for="f-email">Email <span aria-hidden="true">*</span></label>
            <input id="f-email" type="email" name="email" autocomplete="email" placeholder="you@company.com" required />
          </div>
          <div class="field">
            <label for="f-phone">Phone / WhatsApp</label>
            <input id="f-phone" type="tel" name="phone" autocomplete="tel" placeholder="+91" />
          </div>
          <div class="field">
            <label for="f-product">Product</label>
            <input id="f-product" type="text" name="product" list="product-list" placeholder="e.g. n-Butyl Bromide" />
            <datalist id="product-list">
              {productNames.map((n) => <option value={n} />)}
            </datalist>
          </div>
          <div class="field">
            <label for="f-qty">Quantity</label>
            <input id="f-qty" type="text" name="quantity" placeholder="e.g. 2 MT per month" />
          </div>
          <div class="field field--full">
            <label for="f-message">Detailed message <span aria-hidden="true">*</span></label>
            <textarea id="f-message" name="message" rows="5" placeholder="Grade, packaging, destination, delivery schedule" required></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn--ink cform__submit">Send request <Arrow /></button>
        <p class="cform__note">* Required fields</p>
      </form>
    </div>
  </section>

  <!-- Contact details + map, like the info block on dobariya.in -->
  <section class="info sect-white" id="locations">
    <div class="container">
      <div class="info__grid">
        {offices.map((office) => (
          <div class="info__item">
            <h3 class="info__label">{office.label}</h3>
            <p>{office.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
          </div>
        ))}
        <div class="info__item">
          <h3 class="info__label">Phone and email</h3>
          <p>
            <a href={tel}>{contact.phone}</a><br />
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </div>
        <div class="info__item">
          <h3 class="info__label">Working hours</h3>
          <p>{contact.hours}</p>
        </div>
      </div>
      <div class="info__map" id="locations-map" aria-label="Map showing the corporate office and the manufacturing unit"></div>
    </div>
  </section>
</Layout>

<script>
  // Pre-fill the product field when arriving from a product page (?product=Name).
  const product = new URLSearchParams(location.search).get('product');
  const field = document.querySelector<HTMLInputElement>('#f-product');
  if (product && field) field.value = product;
</script>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  // Teal map pin as an inline SVG (no external marker images).
  const pinSvg = `
    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="40" viewBox="0 0 24 36">
      <path d="M12 0C5.4 0 0 5.4 0 12c0 9 12 24 12 24s12-15 12-24c0-6.6-5.4-12-12-12z"
        fill="#069592" style="filter:drop-shadow(0 2px 2px rgba(0,0,0,0.35))"/>
      <circle cx="12" cy="12" r="5" fill="#ffffff"/>
    </svg>`;

  const pinIcon = L.icon({
    iconUrl: `data:image/svg+xml,${encodeURIComponent(pinSvg)}`,
    iconSize: [28, 40],
    iconAnchor: [14, 40],
  });

  const map = L.map('locations-map', { zoomControl: true, scrollWheelZoom: false });

  // OpenStreetMap tiles: free, no API key (CARTO started requiring one).
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    maxZoom: 19,
  }).addTo(map);

  function addLocationMarker(lat: number, lng: number, label: string) {
    const marker = L.marker([lat, lng], { icon: pinIcon }).addTo(map);
    marker.bindTooltip(label, { direction: 'top', offset: [0, -34] });
    marker.on('click', () => {
      window.open(`https://www.google.com/maps?q=${lat},${lng}`, '_blank', 'noopener');
    });
    return marker;
  }

  const office = addLocationMarker(23.0353849, 72.5043858, 'Corporate Office');
  const factory = addLocationMarker(23.27925, 72.391556, 'Manufacturing Unit');

  map.fitBounds(L.latLngBounds([office.getLatLng(), factory.getLatLng()]), { padding: [40, 40] });
</script>

<style>
  .enquiry { padding-block: clamp(48px, 6vw, 88px); }
  .enquiry__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 16px;
    align-items: stretch;
  }

  /* ---- Photo panel ---- */
  .panel { position: relative; overflow: hidden; min-height: 520px; display: flex; align-items: flex-end; background: var(--color-ink); }
  .panel__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 50%; }
  .panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(0deg, rgba(16, 26, 26, 0.95) 0%, rgba(16, 26, 26, 0.55) 55%, rgba(16, 26, 26, 0.15) 100%);
  }
  .panel__body { position: relative; z-index: 2; padding: clamp(24px, 3vw, 40px); }
  .panel__title { font-size: clamp(26px, 2.6vw, 36px); line-height: 1.1; }
  .panel__text { margin-top: 12px; max-width: 40ch; color: var(--color-on-dark); }
  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    font-family: var(--font-display);
    font-variation-settings: "wdth" 110;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .panel__link :global(svg) { width: 16px; height: 16px; transition: transform 0.2s; }
  .panel__link:hover :global(svg) { transform: translateX(4px); }

  /* ---- Form: boxed inputs, full-width submit ---- */
  .cform { background: var(--color-surface); border: 1px solid var(--color-border); padding: clamp(24px, 3.5vw, 48px); }
  .cform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .field { display: grid; gap: 8px; }
  .field--full { grid-column: 1 / -1; }
  .field label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink);
  }
  .field label span { color: var(--color-brand-dark); }
  .field input,
  .field textarea {
    width: 100%;
    padding: 14px 16px;
    font: inherit;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 0.2s, background 0.2s;
  }
  .field textarea { resize: vertical; min-height: 128px; }
  .field input::placeholder, .field textarea::placeholder { color: #98A19E; }
  .field input:focus,
  .field textarea:focus { outline: none; border-color: var(--color-ink); background: var(--color-surface); }
  .cform__submit { width: 100%; justify-content: center; margin-top: 28px; height: 56px; }
  .cform__note { margin-top: 12px; font-size: 14px; color: var(--color-muted); }

  /* ---- Info + map ---- */
  .info { padding-block: clamp(64px, 8vw, 112px); }
  .info__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .info__item { padding-top: 16px; border-top: 1px solid var(--color-ink); line-height: 1.7; }
  .info__item a:hover { color: var(--color-brand-dark); }
  .info__label {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-dark);
  }
  .info__map { margin-top: 48px; height: 440px; border: 1px solid var(--color-border); z-index: 0; }
  /* Grey map so the teal pins are the only colour */
  .info__map :global(.leaflet-tile-pane) { filter: grayscale(1) contrast(0.95) brightness(1.03); }

  /* Netlify honeypot: must stay hidden */
  .hp-field { display: none; }

  /* Keep Leaflet's pins from being squashed by the global img reset */
  :global(.leaflet-marker-icon), :global(.leaflet-marker-shadow) { max-width: none; }

  @media (max-width: 1000px) { .info__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .enquiry__grid { grid-template-columns: 1fr; }
    .panel { min-height: 340px; }
  }
  @media (max-width: 600px) {
    .cform__grid, .info__grid { grid-template-columns: 1fr; }
    .info__map { height: 340px; }
  }
</style>
