---
import Layout from '../layouts/Layout.astro';

// Editable contact data — nothing hardcoded in the markup below.
const contact = {
  email: 'dobaritachemtech@gmail.com',   
  phone: '+91 63558 49826',             
  whatsapp: '916355849826',
  hours: 'Mon–Sat, 9:30 AM – 6:30 PM',  // TODO: confirm
};

const offices = [
  {
    label: 'Corporate Office',
    lines: ['522–523, Shilp Epitome', 'Rajpath Club Road, Bodakdev', 'Ahmedabad – 380054, Gujarat'],
  },
  {
    label: 'Manufacturing Unit',
    lines: ['Plot No. 9, Apex Industrial Park', 'Kadi–Chhatral Highway, Kadi', 'Ahmedabad – 382715, Gujarat'],
  },
];
---

<Layout
  title="Contact & Request a Quote — Dobariya Chemtech"
  description="Request a quote for bromine derivatives. Offices in Bodakdev, Ahmedabad and manufacturing in Kadi, Gujarat."
>
  <section class="contact">
    <div class="container">
      <span class="contact__eyebrow">Get in touch</span>
      <h1 class="contact__title">Request a quote</h1>
      <p class="contact__lead">
        Tell us the products and quantities you need. We'll respond with availability, pricing and documentation.
      </p>

      <div class="contact__grid">
        <!-- LEFT: the form -->
        <form class="cform" action="https://formspree.io/f/xzznanrn" method="POST">
          <label>
            Name
            <input type="text" name="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" required />
          </label>
          <label>
            Company
            <input type="text" name="company" />
          </label>
          <label>
            What do you need?
            <textarea name="message" rows="5" placeholder="Product names and quantities…" required></textarea>
          </label>
          <button type="submit" class="btn btn--primary">Send request →</button>
        </form>

        <!-- RIGHT: slimmed sidebar — quick contact only -->
        <aside class="cinfo">
          <div class="cinfo__block">
            <h3>Contact</h3>
            <p>
              <a href={`mailto:${contact.email}`}>{contact.email}</a><br />
              <a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a>
            </p>
            <a href={`https://wa.me/${contact.whatsapp}`} class="cinfo__wa">Chat on WhatsApp →</a>
          </div>
          <div class="cinfo__block">
            <h3>Working hours</h3>
            <p>{contact.hours}</p>
          </div>
        </aside>
      </div>  <!-- closes .contact__grid -->

      <!-- addresses get their own full-width row, below -->
      <div class="contact__offices" data-reveal-group>
        {offices.map((office) => (
          <div class="office card">
            <h3>{office.label}</h3>
            <p>{office.lines.map((line) => <span>{line}<br /></span>)}</p>
          </div>
        ))}
      </div>  <!-- closes .contact__offices -->

    </div>  <!-- closes .container -->
  </section>
</Layout>

<style>
  .contact { padding-block: var(--space-lg); }
  .contact__eyebrow {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-brand); font-weight: 600;
  }
  .contact__title { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-ink); margin-top: 0.4rem; }
  .contact__lead { color: var(--color-muted); margin-top: var(--space-sm); max-width: 46ch; }

  .contact__grid {
    display: grid;
    grid-template-columns: 1.6fr 0.9fr;   /* was 1.3fr 1fr — form gets more room */
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    align-items: start;
  }

  .cform { display: flex; flex-direction: column; gap: var(--space-sm); }
  .cform label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.9rem; color: var(--color-muted); }
  .cform input, .cform textarea {
    font: inherit; padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border); border-radius: 8px;
    background: var(--color-surface); color: var(--color-ink);
  }
  .cform input:focus, .cform textarea:focus {
    outline: none; border-color: var(--color-brand);
  }
  .cform button { align-self: flex-start; margin-top: var(--space-xs); }

  .cinfo { display: flex; flex-direction: column; gap: var(--space-md); }
  .cinfo__block h3 { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-ink); margin-bottom: 0.4rem; }
  .cinfo__block p { color: var(--color-muted); line-height: 1.7; font-size: 0.95rem; }
  .cinfo__block a:hover { color: var(--color-brand); }
  .cinfo__wa { display: inline-block; margin-top: 0.5rem; color: var(--color-brand); font-weight: 500; }

  .contact__offices {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .office h3 {
    font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink); margin-bottom: 0.5rem;
  }
  .office p { color: var(--color-muted); line-height: 1.7; font-size: 0.95rem; }

  @media (max-width: 860px) {
    .contact__offices { grid-template-columns: 1fr; }
  }

  @media (max-width: 860px) { .contact__grid { grid-template-columns: 1fr; } }
</style>