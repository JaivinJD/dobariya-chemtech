---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Dobariya Chemtech Pvt. Ltd. — Coming Soon</title>
    <meta name="description" content="Dobariya Chemtech Pvt. Ltd. — bromine derivatives manufacturer in Ahmedabad, Gujarat. Website launching soon." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Background photo: Low Angle, unsplash.com/@lowangle, Unsplash License -->
    <main class="soon">
      <div class="soon__overlay"></div>
      <div class="soon__content">
        <span class="soon__eyebrow">Coming Soon</span>
        <h1 class="soon__title">Dobariya Chemtech</h1>
        <p class="soon__tagline">Bromine derivatives, manufactured with consistency — from Gujarat, India.</p>
        <a href="mailto:info@dobariyachemtech.com" class="soon__contact">info@dobariyachemtech.com</a>
      </div>
    </main>
  </body>
</html>

<style>
  .soon {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-image: url('https://images.unsplash.com/photo-1751091764701-98d590af5bfc?auto=format&fit=crop&w=2400&q=70');
    background-size: cover;
    background-position: center;
  }
  .soon__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(35,40,45,0.6) 0%, rgba(35,40,45,0.88) 100%);
  }
  .soon__content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: var(--space-lg);
    max-width: 680px;
  }
  .soon__eyebrow {
    display: block;
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand);
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }
  .soon__title {
    font-size: clamp(2.8rem, 9vw, 5.2rem);
    color: #fff;
    font-weight: 700;
    line-height: 1.05;
  }
  .soon__tagline {
    color: #C7CFCF;
    margin-top: var(--space-md);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .soon__contact {
    display: inline-block;
    margin-top: var(--space-lg);
    color: #fff;
    font-size: 0.95rem;
    border-bottom: 1px solid var(--color-brand);
    padding-bottom: 2px;
  }
  .soon__contact:hover { color: var(--color-brand); }
</style>