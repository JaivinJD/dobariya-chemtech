---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/ui/Arrow.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import { familyBySlug, formulaHtml, withBreaks } from '../../lib/catalog';

// Tells Astro WHICH pages to generate: one per product in the CMS collection.
export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { id: product.id }, // the URL: /products/<id>
    props: { product },         // hand the whole product to the page
  }));
}

const { product } = Astro.props;
const d = product.data;
const family = familyBySlug(d.category);
const familyLabel = family ? `${family.name} · ${family.sub}` : '';

// Spec list built from ONLY the fields that exist, so verified gaps stay hidden.
// `mono: true` = technical value shown in the monospace face.
const specs: { label: string; value: string; html?: string; mono?: boolean }[] = [];
if (d.formula) specs.push({ label: 'Formula', value: d.formula, html: formulaHtml(d.formula), mono: true });
if (d.cas) specs.push({ label: 'CAS number', value: d.cas, mono: true });
if (d.grade) specs.push({ label: 'Grade / purity', value: d.grade });
if (d.appearance) specs.push({ label: 'Appearance', value: d.appearance });
if (d.boilingPoint) specs.push({ label: 'Boiling point', value: d.boilingPoint, mono: true });
if (d.meltingPoint) specs.push({ label: 'Melting point', value: d.meltingPoint, mono: true });
if (d.specificGravity) specs.push({ label: 'Specific gravity', value: d.specificGravity, mono: true });
if (d.packaging?.length) specs.push({ label: 'Packaging', value: d.packaging.join(', ') });

// Up to three key facts for the data plate in the header.
const plateFacts = [
  d.boilingPoint && { label: 'Boiling point', value: d.boilingPoint },
  d.meltingPoint && { label: 'Melting point', value: d.meltingPoint },
  d.specificGravity && { label: 'Specific gravity', value: d.specificGravity },
].filter(Boolean).slice(0, 3) as { label: string; value: string }[];

// Up to four other products from the same family.
const related = (await getCollection('products', (p) => p.data.category === d.category && p.id !== product.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 4);

// The quote button pre-fills the contact form with this product.
const quoteHref = `/contact?product=${encodeURIComponent(d.name)}#enquiry`;

const summary = `${d.name}${d.formula ? ` (${d.formula})` : ''}, manufactured and supplied by Dobariya Chemtech, Ahmedabad.`;

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  description: summary,
  category: familyLabel,
  manufacturer: {
    '@type': 'Organization',
    name: 'Dobariya Chemtech Pvt. Ltd.',
    url: 'https://dobariyachemtech.com',
  },
  ...(d.cas && { productID: d.cas }),
  additionalProperty: specs.map((s) => ({ '@type': 'PropertyValue', name: s.label, value: s.value })),
};
---

<Layout
  title={`${d.name} | Bromine Derivative | Dobariya Chemtech`}
  description={`${summary} Request a quote for pricing and availability.`}
>
  <PageHeader
    crumbs={[
      { label: 'Products', href: '/products' },
      { label: `${family?.name} · ${family?.sub}`, href: `/products#${d.category}` },
    ]}
    label={familyLabel}
    compact
  >
    <Fragment slot="title"><span set:html={withBreaks(d.name)} /></Fragment>
    {d.synonyms && d.synonyms.length > 0 && (
      <p class="aka"><span>Also known as</span> {d.synonyms.join(' · ')}</p>
    )}
    <div class="actions">
      <a href={quoteHref} class="btn btn--primary">Request a quote <Arrow /></a>
      <a href="/brochure.pdf" class="btn btn--ghost-light">Download brochure</a>
    </div>

    <!-- Data plate: the product's "label". Shows the CMS photo on top when one exists. -->
    <div slot="aside" class="plate">
      {d.image && <img src={d.image} alt={d.name} class="plate__img" loading="eager" />}
      <div class="plate__top">
        <span>{family?.short}</span>
        {d.cas && <span>CAS {d.cas}</span>}
      </div>
      {d.formula && <p class="plate__formula"><span set:html={formulaHtml(d.formula)} /></p>}
      {plateFacts.length > 0 && (
        <dl class="plate__facts">
          {plateFacts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      )}
    </div>
  </PageHeader>

  <section class="pd">
    <div class="container">
      <div class="pd__body">
        <div>
          <h2 class="pd__h2">Specification</h2>
          {specs.length > 0 ? (
            <dl class="specs">
              {specs.map((s) => (
                <div class="specs__row">
                  <dt>{s.label}</dt>
                  <dd class:list={{ mono: s.mono }}>{s.html ? <Fragment set:html={s.html} /> : s.value}</dd>
                </div>
              ))}
            </dl>
          ) : (
            <p class="pd__empty">Detailed specifications available on request.</p>
          )}
          <p class="pd__note">Physical properties are typical reference values. Batch specifications are shared on request.</p>
        </div>

        {d.applications && d.applications.length > 0 && (
          <div>
            <h2 class="pd__h2">Applications</h2>
            <ul class="apps">
              {d.applications.map((a) => <li>{a}</li>)}
            </ul>
          </div>
        )}
      </div>

      <!-- Quote strip: light and framed, so the page stays calm between the dark header and footer -->
      <div class="qstrip">
        <div>
          <p class="qstrip__title">Need <Fragment set:html={withBreaks(d.name)} />?</p>
          <p class="qstrip__text">Tell us the grade and quantity. We reply with availability, pricing and documentation.</p>
        </div>
        <a href={quoteHref} class="btn btn--primary">Request a quote <Arrow /></a>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="more">
      <div class="container">
        <div class="more__head">
          <h2 class="pd__h2">More {family?.name.toLowerCase()} · {family?.sub}</h2>
          <a href={`/products#${d.category}`} class="more__all">See all <Arrow /></a>
        </div>
        <div class="more__grid">
          {related.map((p) => (
            <a href={`/products/${p.id}`} class="mini">
              <span class="mini__formula" set:html={formulaHtml(p.data.formula)} />
              <span class="mini__name" set:html={withBreaks(p.data.name)} />
              {p.data.cas && <span class="mini__cas">CAS {p.data.cas}</span>}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
</Layout>

<style>
  /* ---- Header extras (inside the dark PageHeader) ---- */
  .aka { margin-top: 20px; max-width: 60ch; color: var(--color-on-dark); }
  .aka span { margin-right: 8px; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-brand-soft); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .plate {
    background: var(--color-ink-2);
    border: 1px solid var(--color-border-dark);
    font-family: var(--font-mono);
  }
  .plate__img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .plate__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border-dark);
    font-size: 12px;
    color: var(--color-muted-dark);
  }
  .plate__formula {
    padding: 28px 20px;
    font-size: clamp(28px, 2.8vw, 40px);
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
  }
  .plate__formula :global(sub) { font-size: 0.55em; }
  .plate__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    border-top: 1px solid var(--color-border-dark);
  }
  .plate__facts div { padding: 14px 20px; }
  .plate__facts div + div { border-left: 1px solid var(--color-border-dark); }
  .plate__facts dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted-dark); }
  .plate__facts dd { margin: 6px 0 0; font-size: 17px; color: #fff; }

  /* ---- Body ---- */
  .pd { padding-block: var(--section-sm); }
  .pd__body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px clamp(40px, 6vw, 112px);
  }
  .pd__h2 {
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-dark);
    margin-bottom: 20px;
  }
  .specs { border-top: 1px solid var(--color-ink); }
  .specs__row {
    display: grid;
    grid-template-columns: minmax(140px, 2fr) 3fr;
    gap: 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  .specs dt { color: var(--color-muted); }
  .specs dd { margin: 0; }
  .specs dd.mono { font-family: var(--font-mono); font-size: 16px; }
  .specs dd :global(sub) { font-size: 0.7em; }
  .pd__note { margin-top: 16px; font-size: 14px; color: var(--color-muted); }
  .pd__empty { color: var(--color-muted); }

  .apps { list-style: none; padding: 0; border-top: 1px solid var(--color-ink); }
  .apps li { position: relative; padding: 16px 0 16px 28px; border-bottom: 1px solid var(--color-border); }
  .apps li::before { content: ""; position: absolute; left: 0; top: 27px; width: 12px; height: 1px; background: var(--color-brand); }

  /* ---- Quote strip ---- */
  .qstrip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px 40px;
    margin-top: var(--section-sm);
    padding: clamp(24px, 3vw, 40px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-brand);
  }
  .qstrip__title {
    font-family: var(--font-display);
    font-variation-settings: "wdth" var(--display-wdth);
    font-weight: var(--display-weight);
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .qstrip__text { margin-top: 8px; max-width: 52ch; color: var(--color-muted); }

  /* Related */
  .more { padding-block: 0 var(--section-sm); }
  .more__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0 16px; }
  .more__all { white-space: nowrap; margin-bottom: 20px; }
  .more__all { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 13px; }
  .more__all :global(svg) { width: 14px; height: 14px; transition: transform 0.2s; }
  .more__all:hover :global(svg) { transform: translateX(4px); }
  .more__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .mini {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }
  .mini:hover { border-color: var(--color-ink); }
  .mini__formula { font-family: var(--font-mono); font-size: 22px; margin-bottom: 20px; }
  .mini__formula :global(sub) { font-size: 0.6em; }
  .mini__name { font-weight: 600; line-height: 1.25; overflow-wrap: anywhere; }
  .mini__cas { font-family: var(--font-mono); font-size: 12px; color: var(--color-muted); }

  @media (max-width: 900px) {
    .pd__body { grid-template-columns: 1fr; }
    .more__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .specs__row { grid-template-columns: 1fr; gap: 4px; }
    .more__grid { grid-template-columns: 1fr; }
    .qstrip .btn { width: 100%; justify-content: center; }
  }
</style>
