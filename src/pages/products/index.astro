---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Arrow from '../../components/ui/Arrow.astro';
import headerImg from '../../assets/photos/bottles.jpg';
import { families, formulaHtml, withBreaks } from '../../lib/catalog';

// Every product from the CMS collection (already schema-validated), A to Z.
const products = (await getCollection('products')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const inFamily = (slug: string) => products.filter((p) => p.data.category === slug);

// Short appearance for the table: "Colourless liquid (turns pale...)" -> "Colourless liquid"
const shortAppearance = (s?: string) => (s ? s.split(' (')[0] : '');
---

<Layout
  title="Products | Bromine Derivatives | Dobariya Chemtech"
  description="Our full range of bromine derivatives in three families: alkyl bromides in solvents, solid and inorganic bromides, and specialty bromides. Formula, CAS number and specification for each."
>
  <PageHeader
    image={headerImg}
    imagePos="70% 50%"
    label="Products"
    title="Bromine derivatives"
    lead={`${products.length} products across three families, manufactured and supplied from our facility in Kadi, Gujarat. Open any product for its full specification.`}
  >
    <div slot="aside" class="jump">
      <p class="label jump__label">Jump to a family</p>
      {families.map((f, i) => (
        <a href={`#${f.slug}`} class="jump__row">
          <span class="jump__no">{String(i + 1).padStart(2, '0')}</span>
          <span class="jump__name">{f.name} <small>{f.sub}</small></span>
          <span class="jump__count">{inFamily(f.slug).length}</span>
        </a>
      ))}
    </div>
  </PageHeader>

  <!-- Search: filters the tables below. Without JS the full list simply shows. -->
  <div class="finder" data-finder hidden>
    <div class="container finder__in">
      <label class="finder__field">
        <span class="sr-only">Search products</span>
        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="8.5" cy="8.5" r="6" /><path d="M13 13l5 5" /></svg>
        <input type="search" placeholder="Search by name, formula or CAS number" data-finder-input autocomplete="off" />
      </label>
      <p class="finder__count" aria-live="polite" data-finder-count></p>
    </div>
  </div>

  <div class="container cat">
    {families.map((f, i) => (
      <section class="fam" id={f.slug} data-fam>
        <div class="fam__head">
          <span class="fam__no">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="fam__name">{f.name} <span>{f.sub}</span></h2>
            <p class="fam__blurb">{f.blurb}</p>
          </div>
          <p class="fam__count">{inFamily(f.slug).length}<span>products</span></p>
        </div>

        <div class="tbl" role="table" aria-label={`${f.name}, ${f.sub}`}>
          <div class="tbl__row tbl__row--head" role="row">
            <span role="columnheader">Product</span>
            <span role="columnheader">Formula</span>
            <span role="columnheader">CAS No.</span>
            <span role="columnheader">Appearance</span>
            <span role="columnheader"><span class="sr-only">Open</span></span>
          </div>
          {inFamily(f.slug).map((p) => (
            <a
              href={`/products/${p.id}`}
              class="tbl__row"
              role="row"
              data-search={[p.data.name, p.data.formula, p.data.cas, ...(p.data.synonyms ?? [])].join(' ').toLowerCase()}
            >
              <span class="tbl__name" role="cell" set:html={withBreaks(p.data.name)} />
              <span class="tbl__formula" role="cell" set:html={formulaHtml(p.data.formula)} />
              <span class="tbl__cas" role="cell">{p.data.cas}</span>
              <span class="tbl__app" role="cell">{shortAppearance(p.data.appearance)}</span>
              <span class="tbl__go" role="cell" aria-hidden="true"><Arrow /></span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="empty" data-finder-empty hidden>
      No product matches that search. <a href="/contact#enquiry">Ask us about it</a>, we may still be able to supply it.
    </p>
  </div>

  <!-- Closing prompt -->
  <section class="ask">
    <div class="container ask__in">
      <div>
        <span class="label">Not on the list?</span>
        <h2 class="h2 ask__title">Tell us what you need.</h2>
      </div>
      <div>
        <p class="ask__text">Send the product, grade and quantity. We reply with pricing, lead time and documentation.</p>
        <a href="/contact#enquiry" class="btn btn--primary">Request a quote <Arrow /></a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ---- Family jump list in the header ---- */
  .jump { border-top: 1px solid rgba(255, 255, 255, 0.5); }
  .jump__label { padding-block: 14px 6px; }
  .jump__row {
    display: grid;
    grid-template-columns: 40px 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding-block: 14px;
    border-bottom: 1px solid var(--color-border-dark);
    transition: color 0.2s;
  }
  .jump__row:hover { color: var(--color-brand-soft); }
  .jump__no { font-family: var(--font-mono); font-size: 13px; color: var(--color-brand-soft); }
  .jump__name { font-weight: 600; }
  .jump__name small { font-weight: 400; font-size: 15px; color: var(--color-muted-dark); }
  .jump__count { font-family: var(--font-mono); font-size: 14px; }

  /* ---- Search bar, sticks under the navbar ---- */
  .finder {
    position: sticky;
    top: var(--nav-h);
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .finder__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 14px; }
  .finder__field {
    flex: 1;
    max-width: 520px;
    display: flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding-inline: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: border-color 0.2s;
  }
  .finder__field:focus-within { border-color: var(--color-ink); }
  .finder__field svg { width: 18px; height: 18px; flex: none; color: var(--color-muted); }
  .finder__field input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; color: var(--color-ink); }
  .finder__count { font-family: var(--font-mono); font-size: 13px; color: var(--color-muted); white-space: nowrap; }

  /* ---- Family blocks ---- */
  .cat { padding-block: var(--section-sm); }
  .fam + .fam { margin-top: var(--section-sm); }
  .fam__head {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: 24px;
    align-items: end;
  }
  .fam__no { align-self: start; padding-top: 10px; font-family: var(--font-mono); font-size: 14px; color: var(--color-brand-dark); }
  .fam__name { font-variation-settings: "wdth" var(--display-wdth); font-size: var(--fs-h2); line-height: 1.05; }
  .fam__name span { font-family: var(--font-body); font-variation-settings: normal; font-weight: 400; font-size: 17px; letter-spacing: 0; color: var(--color-muted); }
  .fam__blurb { margin-top: 10px; max-width: 60ch; color: var(--color-muted); }
  .fam__count {
    text-align: right;
    font-family: var(--font-display);
    font-variation-settings: "wdth" var(--display-wdth);
    font-size: clamp(28px, 2.6vw, 36px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .fam__count span { display: block; margin-top: 6px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-muted); }

  /* ---- Catalogue table: one framed white panel per family ---- */
  .tbl { margin-top: 28px; background: var(--color-surface); border: 1px solid var(--color-border); }
  .tbl__row:last-child { border-bottom: 0; }
  .tbl__row {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1.3fr) minmax(0, 1.1fr) minmax(0, 2fr) 44px;
    gap: 24px;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-border);
    transition: background 0.2s;
  }
  .tbl__row--head {
    padding-block: 14px;
    background: #E9ECE9;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  a.tbl__row:hover { background: var(--color-bg); }
  .tbl__name { font-weight: 600; font-size: 17px; overflow-wrap: anywhere; }
  .tbl__formula { font-family: var(--font-mono); font-size: 16px; }
  .tbl__formula :global(sub) { font-size: 0.7em; }
  .tbl__cas { font-family: var(--font-mono); font-size: 14px; color: var(--color-muted); font-variant-numeric: tabular-nums; }
  .tbl__app { font-size: 15px; color: var(--color-muted); }
  .tbl__go {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-border);
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .tbl__go :global(svg) { width: 15px; height: 15px; }
  a.tbl__row:hover .tbl__go { background: var(--color-brand); border-color: var(--color-brand); color: #fff; }

  .empty { padding: 48px 0; font-size: 18px; color: var(--color-muted); }
  .empty a { color: var(--color-ink); text-decoration: underline; text-decoration-color: var(--color-brand); text-underline-offset: 3px; }

  /* ---- Closing prompt ---- */
  .ask { background: var(--color-surface); border-top: 1px solid var(--color-border); padding-block: var(--section-sm); }
  .ask__in { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: end; }
  .ask__title { margin-top: 18px; }
  .ask__text { max-width: 44ch; color: var(--color-muted); margin-bottom: 28px; }

  @media (max-width: 1000px) {
    .tbl__row { grid-template-columns: minmax(0, 2fr) minmax(0, 1.2fr) minmax(0, 1fr) 40px; }
    .tbl__app, .tbl__row--head span:nth-child(4) { display: none; }
  }
  @media (max-width: 700px) {
    .fam__head { grid-template-columns: 1fr auto; }
    .fam__no { grid-column: 1 / -1; padding-top: 0; }
    .tbl__row--head { display: none; }
    .tbl__row {
      grid-template-columns: 1fr 40px;
      grid-template-areas: "name go" "meta go";
      gap: 4px 16px;
      padding-inline: 16px;
    }
    .tbl__name { grid-area: name; }
    .tbl__go { grid-area: go; }
    .tbl__formula, .tbl__cas { grid-area: meta; }
    .tbl__cas { justify-self: end; }
    .ask__in { grid-template-columns: 1fr; }
    .finder__count { display: none; }
  }
</style>

<script>
  // Live search over the catalogue. Progressive: the bar only appears when JS runs.
  const finder = document.querySelector<HTMLElement>('[data-finder]');
  const input = document.querySelector<HTMLInputElement>('[data-finder-input]');
  const count = document.querySelector<HTMLElement>('[data-finder-count]');
  const empty = document.querySelector<HTMLElement>('[data-finder-empty]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-search]')];
  const fams = [...document.querySelectorAll<HTMLElement>('[data-fam]')];

  if (finder && input && count && empty) {
    finder.hidden = false;
    const total = rows.length;
    const run = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      rows.forEach((r) => {
        const hit = !q || (r.dataset.search ?? '').includes(q);
        r.hidden = !hit;
        if (hit) shown++;
      });
      // hide a whole family when none of its products match
      fams.forEach((f) => { f.hidden = !f.querySelector('[data-search]:not([hidden])'); });
      empty.hidden = shown > 0;
      count.textContent = q ? `${shown} of ${total} products` : `${total} products`;
    };
    input.addEventListener('input', run);
    run();
  }
</script>
