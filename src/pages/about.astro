---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const intro = {
  eyebrow: 'About us',
  title: 'Chemistry built on consistency',
  lead: 'Dobariya Chemtech Pvt. Ltd. manufactures and supplies bromine derivatives from Gujarat, India — serving industrial and export buyers who need reliable quality, batch after batch.',
};

const story = [
  "Dobariya Chemtech Pvt. Ltd. manufactures bromine derivatives from our own production facility in Kadi, Gujarat, with corporate offices in Ahmedabad. We're part of the Dobariya Group, which has been building across Ahmedabad since 1989 — and that same discipline shows up in how we run our chemical operations: in-house production, consistent specifications, and a straightforward relationship with every buyer we work with.",
  "Our product range covers alkyl, aryl, and inorganic bromides — from high-volume industrial chemicals to specialty bromine compounds — serving customers across a range of industries with a focus on dependable quality, consistent specifications, and reliable supply.",
  "We work with both domestic manufacturers and international buyers, supplying products that meet defined technical and commercial requirements. Our operations are supported by quality checks, batch-wise documentation, appropriate packaging, and a practical approach to customer requirements — whether it is a regular supply program or a new product requirement.",
  "We believe long-term relationships in the chemical industry are built through consistency and accountability. Our objective is not simply to supply a product, but to become a dependable manufacturing partner for customers who value reliable quality, responsive communication, and supply they can plan around.",
  "We're a company built on an established foundation — small enough that every order gets direct attention, backed by a group with decades of experience delivering on commitments, and focused on building a modern chemical manufacturing business for the long term.",
];

const founder = {
  name: 'Shrut Dobariya',
  title: 'Director',
  bio: "As the company grows, he brings a strong technical and modern business perspective to the organization. He holds a B.Tech. in Chemical Science & Technology from IIT Guwahati and is involved in the company's manufacturing, business development, and growth initiatives, with a focus on building stronger capabilities in bromine chemistry.",
};

const products = await getCollection('products');

const capabilities = [
  { title: 'In-house manufacturing', text: 'Production at our own facility in Kadi, Gujarat — not just trading.' },
  { title: 'Broad product range', text: `${products.length} bromine derivatives across three categories, from bulk to specialty.` },
  { title: 'Export-ready supply', text: 'Export-grade quality and documentation for international buyers.' },
];

const facilities = [
  {
    label: 'Corporate Office',
    lines: ['522–523, Shilp Epitome', 'Rajpath Club Road, Bodakdev', 'Ahmedabad – 380054, Gujarat'],
  },
  {
    label: 'Manufacturing Unit',
    lines: ['Plot No. 9, Apex Industrial Park', 'Kadi–Chhatral Highway, Kadi', 'Ahmedabad – 382715, Gujarat'],
  },
];
---

<Layout
  title="About — Dobariya Chemtech Pvt. Ltd."
  description="A bromine-derivatives manufacturer in Ahmedabad, Gujarat, with in-house production in Kadi and a focus on consistent, export-grade quality."
>
  <section class="about">
    <div class="container">
      <header class="about__head">
        <span class="about__eyebrow">{intro.eyebrow}</span>
        <h1 class="about__title">{intro.title}</h1>
        <p class="about__lead">{intro.lead}</p>
      </header>

      <div class="about__story">
        {story.map((para) => <p>{para}</p>)}
      </div>

      <div class="about__leader">
        <div class="leader__text">
          <span class="leader__eyebrow">Leadership</span>
          <h3>{founder.name}</h3>
          <span class="leader__title">{founder.title}</span>
          <p>{founder.bio}</p>
        </div>
        <img src="/shrut-photo.jpeg" alt="Shrut Dobariya, Director" class="leader__photo" />
      </div>

      <div class="about__caps" data-reveal-group>
        {capabilities.map((c) => (
          <article class="cap card">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </article>
        ))}
      </div>

      <div class="about__facilities">
        <h2 class="about__subhead">Our facilities</h2>
        <div class="about__facgrid" data-reveal-group>
          {facilities.map((f) => (
            <div class="fac">
              <h4>{f.label}</h4>
              <p>{f.lines.map((line) => <span>{line}<br /></span>)}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="about__cta">
        <div>
          <h2>Looking for a specific bromine derivative?</h2>
          <p>Browse our full range or request a quote — we'll respond with availability and pricing.</p>
        </div>
        <div class="about__ctabtns">
            <a href="/products" class="btn btn--ghost-light">View products</a>
            <a href="/contact" class="btn btn--primary">Request a quote →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about { padding-block: var(--space-lg); }
  .about__head { max-width: 720px; }
  .about__eyebrow {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-brand); font-weight: 600;
  }
  .about__title { font-size: clamp(2rem, 5vw, 3rem); color: var(--color-ink); margin-top: 0.4rem; }
  .about__lead { color: var(--color-muted); margin-top: var(--space-sm); font-size: 1.1rem; line-height: 1.6; }

  .about__story { max-width: 720px; margin-top: var(--space-lg); }
  .about__story p { color: var(--color-ink); line-height: 1.8; margin-bottom: var(--space-sm); }

  .about__leader {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-lg);
    align-items: flex-start;
    margin-top: var(--space-xl);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .leader__eyebrow {
    font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-brand); font-weight: 600;
  }
  .about__leader h3 { font-size: 1.5rem; color: var(--color-ink); margin-top: 0.3rem; }
  .leader__title {
    font-size: 0.85rem; color: var(--color-brand); font-weight: 600;
    display: block; margin: 0.3rem 0 0.6rem;
  }
  .about__leader p { color: var(--color-muted); line-height: 1.7; max-width: 55ch; }
  .leader__photo {
    width: 100%;
    max-width: 180px;
    aspect-ratio: 4 / 5;
    justify-self: end;
    border-radius: 10px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  .about__caps {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .cap {
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 12px; padding: var(--space-md);
  }
  .cap h3 { font-size: 1.05rem; color: var(--color-ink); margin-bottom: 0.4rem; }
  .cap p { font-size: 0.92rem; color: var(--color-muted); line-height: 1.6; }

  .about__facilities { margin-top: var(--space-xl); }
  .about__subhead { font-size: 1.5rem; color: var(--color-ink); margin-bottom: var(--space-md); }
  .about__facgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  .fac { border-top: 2px solid var(--color-brand); padding-top: var(--space-sm); }
  .fac h4 {
    font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--color-ink); margin-bottom: 0.5rem;
  }
  .fac p { color: var(--color-muted); line-height: 1.7; }

  .about__cta {
    margin-top: var(--space-xl);
    background: var(--color-ink);
    border-radius: 16px; padding: var(--space-lg);
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md); flex-wrap: wrap;
  }
  .about__cta h2 { color: #fff; font-size: 1.5rem; }
  .about__cta p { color: #b9c4c4; margin-top: 0.4rem; }
  .about__ctabtns { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  @media (max-width: 860px) {
    .about__caps { grid-template-columns: 1fr; }
    .about__facgrid { grid-template-columns: 1fr; }
    .about__leader { grid-template-columns: 1fr; }
    .leader__photo { justify-self: start; max-width: 280px; }
  }
</style>