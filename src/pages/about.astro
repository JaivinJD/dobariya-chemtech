---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import CtaStrip from '../components/ui/CtaStrip.astro';
import Arrow from '../components/ui/Arrow.astro';
import { getCollection } from 'astro:content';
import { offices as facilities } from '../data/offices.json';
import headerImg from '../assets/photos/roof.jpg';
import GroupLogo from '../assets/dobariya-group-logo.svg';

// Copy below is Shrut's approved text. Only punctuation was changed
// (em dashes replaced), the wording is his.
const intro = {
  label: 'About us',
  title: 'Chemistry built on consistency',
  lead: 'Dobariya Chemtech Pvt. Ltd. manufactures and supplies bromine derivatives from Gujarat, India, serving industrial and export buyers who need reliable quality, batch after batch.',
};

const story = [
  "Dobariya Chemtech Pvt. Ltd. manufactures bromine derivatives from our own production facility in Kadi, Gujarat, with corporate offices in Ahmedabad. We're part of the Dobariya Group, which has been building across Ahmedabad since 1989, and that same discipline shows up in how we run our chemical operations: in-house production, consistent specifications, and a straightforward relationship with every buyer we work with.",
  "Our product range covers alkyl, aryl, and inorganic bromides, from high-volume industrial chemicals to specialty bromine compounds, serving customers across a range of industries with a focus on dependable quality, consistent specifications, and reliable supply.",
  "We work with both domestic manufacturers and international buyers, supplying products that meet defined technical and commercial requirements. Our operations are supported by quality checks, batch-wise documentation, appropriate packaging, and a practical approach to customer requirements, whether it is a regular supply program or a new product requirement.",
  "We believe long-term relationships in the chemical industry are built through consistency and accountability. Our objective is not simply to supply a product, but to become a dependable manufacturing partner for customers who value reliable quality, responsive communication, and supply they can plan around.",
  "We're a company built on an established foundation: small enough that every order gets direct attention, backed by a group with decades of experience delivering on commitments, and focused on building a modern chemical manufacturing business for the long term.",
];

// Pull quote: a line lifted from the story above, not new copy.
const pullQuote = 'Not simply to supply a product, but to become a dependable manufacturing partner.';

const products = await getCollection('products');

// Fixed in code by decision (not CMS-editable).
const capabilities = [
  { title: 'In-house manufacturing', text: 'Production at our own facility in Kadi, Gujarat, not just trading.' },
  { title: 'Broad product range', text: `${products.length} bromine derivatives across three categories, from bulk to specialty.` },
  { title: 'Export-ready supply', text: 'Export-grade quality and documentation for international buyers.' },
];
---

<Layout
  title="About | Dobariya Chemtech Pvt. Ltd."
  description="A bromine-derivatives manufacturer in Ahmedabad, Gujarat, with in-house production in Kadi and a focus on consistent, export-grade quality."
>
  <PageHeader label={intro.label} title={intro.title} lead={intro.lead} image={headerImg} imagePos="50% 35%" />

  <!-- Story: pull quote on the left (sticky), Shrut's paragraphs on the right -->
  <section class="story">
    <div class="container story__grid">
      <aside class="story__side">
        <span class="label">Our story</span>
        <blockquote class="story__quote">{pullQuote}</blockquote>
      </aside>
      <div class="story__text" data-reveal>
        {story.map((para, i) => <p class:list={{ 'story__first': i === 0 }}>{para}</p>)}
      </div>
    </div>
  </section>

  <!-- Capabilities: three columns with a top rule. No cards, no numbering. -->
  <section class="caps sect-white">
    <div class="container caps__grid" data-reveal-group>
      {capabilities.map((c) => (
        <div class="cap">
          <h2 class="cap__title">{c.title}</h2>
          <p>{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The Dobariya Group: the main, deliberate link to the parent company -->
  <section class="group">
    <div class="container">
      <div class="group__panel" data-reveal>
        <div>
          <span class="label">Part of the Dobariya Group</span>
          <h2 class="group__title">Different industry,<br />same discipline.</h2>
        </div>
        <div class="group__body">
          <GroupLogo class="group__logo" role="img" aria-label="Dobariya Group, since 1989" />
          <p>
            We are the chemicals arm of the Dobariya Group, which has been building homes
            and commercial spaces across Ahmedabad for more than three decades.
          </p>
          <a href="https://dobariya.in" target="_blank" rel="noopener" class="btn btn--ghost">
            Visit dobariya.in <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Facilities (from the CMS offices file) -->
  <section class="fac sect-white">
    <div class="container">
      <div class="fac__head">
        <span class="label">Our facilities</span>
        <a href="/contact#locations" class="fac__map">See them on the map <Arrow /></a>
      </div>
      <div class="fac__grid" data-reveal-group>
        {facilities.map((f) => (
          <div class="fac__item">
            <h3 class="fac__label">{f.label}</h3>
            <p>{f.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="end">
    <div class="container">
      <CtaStrip title="Looking for a specific bromine derivative?" text="Browse our full range or request a quote. We'll respond with availability and pricing.">
        <a href="/products" class="btn btn--ghost">View products</a>
        <a href="/contact#enquiry" class="btn btn--primary">Request a quote <Arrow /></a>
      </CtaStrip>
    </div>
  </section>
</Layout>

<style>
  /* ---- Story ---- */
  .story { padding-block: var(--section); }
  .story__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px clamp(40px, 6vw, 112px); }
  .story__side { align-self: start; position: sticky; top: calc(var(--nav-h) + 40px); }
  .story__quote {
    margin: 24px 0 0;
    padding-left: 24px;
    border-left: 3px solid var(--color-brand);
    font-family: var(--font-display);
    font-variation-settings: "wdth" var(--display-wdth);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .story__text { display: grid; gap: 22px; max-width: 64ch; color: var(--color-muted); font-size: 17px; line-height: 1.7; }
  .story__text .story__first { color: var(--color-ink); font-size: var(--fs-lead); line-height: 1.6; }

  /* ---- Capabilities ---- */
  .caps { padding-block: var(--section-sm); }
  .caps__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .cap { padding-top: 20px; border-top: 1px solid var(--color-ink); }
  .cap__title { font-size: var(--fs-h3); line-height: 1.15; margin-bottom: 10px; }
  .cap p { color: var(--color-muted); }

  /* ---- Group ---- */
  .group { padding-block: var(--section-sm) var(--section); }
  .group__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px clamp(40px, 6vw, 112px);
    align-items: start;
    padding: clamp(28px, 4vw, 56px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-brand);
  }
  .group__title {
    margin-top: 18px;
    font-variation-settings: "wdth" var(--display-wdth);
    font-size: var(--fs-h2);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .group__body { display: grid; gap: 24px; justify-items: start; }
  /* Parent group logo, original colours from their CorelDRAW file */
  .group__logo { display: block; height: clamp(56px, 5.4vw, 76px); width: auto; margin-bottom: 4px; }
  .group__body p { font-size: 17px; line-height: 1.6; color: var(--color-muted); max-width: 46ch; }

  /* ---- Facilities ---- */
  .fac { padding-block: var(--section-sm); }
  .fac__head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; }
  .fac__map { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 13px; }
  .fac__map :global(svg) { width: 14px; height: 14px; transition: transform 0.2s; }
  .fac__map:hover :global(svg) { transform: translateX(4px); }
  .fac__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
  .fac__item { padding-top: 20px; border-top: 1px solid var(--color-ink); font-size: 16px; line-height: 1.7; }
  .fac__label {
    margin-bottom: 10px;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-dark);
  }

  .end { padding-block: var(--section-sm); }

  @media (max-width: 900px) {
    .story__grid, .group__panel { grid-template-columns: 1fr; }
    .group__body { padding-top: 8px; }
    .story__side { position: static; }
    .caps__grid { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 600px) {
    .fac__grid { grid-template-columns: 1fr; gap: 28px; }
    .story__text { font-size: 17px; }
  }
</style>
